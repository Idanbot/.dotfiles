#!/usr/bin/env bash
# Launch an agent workspace through Herdr or tmux without implicit nesting.

set -euo pipefail
umask 077

TMUXP_VERSION="${DOTFILES_TMUXP_VERSION:-1.74.0}"
WORKDIR="$PWD"
SESSION_NAME=""
BACKEND="${DOTFILES_WORKSPACE_BACKEND:-auto}"
PRINT_ONLY=false
ALLOW_NESTED=false
AGENT_SELECTION=""
RESTART_AGENTS=false
HEALTH_ONLY=false
TMUX_RENDERED=""

usage() {
  cat <<'USAGE'
Usage: dot-workspace [directory] [options]

Options:
  --backend <auto|herdr|tmux>  Select the workspace backend (default: auto)
  --name <session>             Override the project workspace/session name
  --agents <list>              Launch a comma-separated subset of registered agents
  --restart-agents             Restart an agent after a non-zero exit
  --check                      Validate tools and agent CLIs without launching
  --allow-nested               Permit an explicit cross-multiplexer launch
  --print                      Print the resolved plan without launching it
  -h, --help                   Show this help

Auto routing stays in Herdr or tmux when already inside one. On a bare terminal
it prefers Herdr when available and otherwise falls back to tmuxp.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend)
      BACKEND="${2:-}"
      shift 2
      ;;
    --backend=*)
      BACKEND="${1#--backend=}"
      shift
      ;;
    --name)
      SESSION_NAME="${2:-}"
      shift 2
      ;;
    --name=*)
      SESSION_NAME="${1#--name=}"
      shift
      ;;
    --agents)
      AGENT_SELECTION="${2:-}"
      shift 2
      ;;
    --agents=*)
      AGENT_SELECTION="${1#--agents=}"
      shift
      ;;
    --restart-agents)
      RESTART_AGENTS=true
      shift
      ;;
    --check | --health)
      HEALTH_ONLY=true
      shift
      ;;
    --allow-nested)
      ALLOW_NESTED=true
      shift
      ;;
    --print)
      PRINT_ONLY=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      printf 'Unknown option: %s\n' "$1" >&2
      exit 2
      ;;
    *)
      WORKDIR="$1"
      shift
      ;;
  esac
done

case "$BACKEND" in auto | herdr | tmux) ;;
*)
  printf 'Unknown workspace backend: %s\n' "$BACKEND" >&2
  exit 2
  ;;
esac

WORKDIR="$(cd "$WORKDIR" && pwd -P)"
if [[ -z "$SESSION_NAME" ]]; then
  path_hash="$(printf '%s' "$WORKDIR" | sha256sum)"
  SESSION_NAME="$(printf '%s' "$(basename "$WORKDIR")" | tr -cs '[:alnum:]_-' '_')-agents-${path_hash:0:12}"
fi
[[ "$SESSION_NAME" =~ ^[[:alnum:]_-]+$ ]] || {
  printf 'Session name may contain only letters, numbers, underscore, and dash\n' >&2
  exit 2
}

config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
REGISTRY="${DOTFILES_AGENT_REGISTRY:-$config_root/dotfiles/agents.yaml}"
if [[ ! -f "$REGISTRY" ]] && command -v chezmoi >/dev/null 2>&1; then
  source_dir="$(chezmoi source-path 2>/dev/null || true)"
  [[ -f "$source_dir/agents.yaml" ]] && REGISTRY="$source_dir/agents.yaml"
fi
[[ -f "$REGISTRY" ]] || {
  printf 'Missing agent registry: %s\n' "$REGISTRY" >&2
  exit 1
}
command -v yq >/dev/null 2>&1 || {
  printf 'yq is required to read the agent registry\n' >&2
  exit 1
}

mapfile -t AGENTS < <(yq -r '.workspace.agents[]' "$REGISTRY")
[[ ${#AGENTS[@]} -gt 0 ]] || {
  printf 'Agent registry contains no workspace agents\n' >&2
  exit 1
}
if [[ -n "$AGENT_SELECTION" ]]; then
  declare -a selected_agents=()
  IFS=',' read -r -a selected_agents <<<"$AGENT_SELECTION"
  AGENTS=()
  for agent in "${selected_agents[@]}"; do
    yq -e --arg agent "$agent" '.workspace.agents[] | select(. == $agent)' \
      "$REGISTRY" >/dev/null || {
      printf 'Agent is not registered for workspaces: %s\n' "$agent" >&2
      exit 2
    }
    AGENTS+=("$agent")
  done
fi
for agent in "${AGENTS[@]}"; do
  [[ "$agent" =~ ^[[:alnum:]_-]+$ ]] || {
    printf 'Invalid agent id in registry: %s\n' "$agent" >&2
    exit 1
  }
done

if [[ "$BACKEND" == auto ]]; then
  if [[ "${HERDR_ENV:-}" == 1 ]]; then
    BACKEND=herdr
  elif [[ -n "${TMUX:-}" ]]; then
    BACKEND=tmux
  elif command -v herdr >/dev/null 2>&1; then
    BACKEND=herdr
  else
    BACKEND=tmux
  fi
fi

if [[ "$BACKEND" == tmux && "${HERDR_ENV:-}" == 1 && "$ALLOW_NESTED" == false ]]; then
  printf 'Refusing to launch tmux inside Herdr; use the Herdr backend or pass --allow-nested\n' >&2
  exit 2
fi
if [[ "$BACKEND" == herdr && -n "${TMUX:-}" && "${HERDR_ENV:-}" != 1 && "$ALLOW_NESTED" == false ]]; then
  printf 'Refusing to launch Herdr inside tmux; use the tmux backend or pass --allow-nested\n' >&2
  exit 2
fi

check_command() {
  local command_name="$1" required="${2:-true}"
  if command -v "$command_name" >/dev/null 2>&1; then
    printf '[PASS] %s\n' "$command_name"
    return 0
  fi
  if [[ "$required" == true ]]; then
    printf '[FAIL] %s is not installed\n' "$command_name"
    return 1
  fi
  printf '[INFO] %s is not installed (optional)\n' "$command_name"
}

check_workspace() {
  local failed=0 command_name required
  printf 'Workspace preflight\n'
  printf '  backend: %s\n  directory: %s\n  registry: %s\n' \
    "$BACKEND" "$WORKDIR" "$REGISTRY"
  check_command yq || failed=1
  check_command dot-agent-launch || failed=1
  case "$BACKEND" in
    tmux)
      check_command tmux || failed=1
      check_command uvx || failed=1
      ;;
    herdr)
      check_command herdr || failed=1
      check_command jq || failed=1
      ;;
  esac
  for agent in "${AGENTS[@]}"; do
    command_name="$(yq -r --arg agent "$agent" '.agents[$agent].command // ""' "$REGISTRY")"
    required="$(yq -r --arg agent "$agent" '.agents[$agent].required // false' "$REGISTRY")"
    check_command "$command_name" "$required" || failed=1
  done
  if command -v agent-mcp >/dev/null 2>&1; then
    printf '[PASS] agent-mcp manager available (MCP state is unchanged)\n'
  else
    printf '[INFO] agent-mcp manager is not installed (optional)\n'
  fi
  return "$failed"
}

if [[ "$HEALTH_ONLY" == true ]]; then
  if check_workspace; then
    exit 0
  fi
  exit 1
fi

print_herdr_plan() {
  python3 - "$SESSION_NAME" "$WORKDIR" "$RESTART_AGENTS" "${AGENTS[@]}" <<'PY'
import json
import sys

session, workdir, restart, *agents = sys.argv[1:]
print(json.dumps({
    "backend": "herdr",
    "workspace": session,
    "directory": workdir,
    "agents": agents,
    "restart_agents": restart == "true",
}, indent=2))
PY
}

render_tmux_workspace() {
  local destination="$1" prefix=C-s template
  template="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxp/agent-workspace.yaml"
  [[ -f "$template" ]] || {
    printf 'Missing workspace template: %s\n' "$template" >&2
    return 1
  }
  [[ "${HERDR_ENV:-}" == 1 ]] && prefix=C-b

  python3 - "$template" "$destination" "$SESSION_NAME" "$WORKDIR" "$prefix" "$REGISTRY" \
    "$RESTART_AGENTS" "${AGENTS[@]}" <<'PY'
import json
import re
import shlex
import sys
from pathlib import Path

source, destination, session, workdir, prefix, registry, restart, *agents = sys.argv[1:]
for agent in agents:
    if not re.fullmatch(r"[A-Za-z0-9_-]+", agent):
        raise SystemExit(f"invalid agent id: {agent}")

windows = []
for agent in agents:
    launch = ["dot-agent-launch"]
    if restart == "true":
        launch.append("--restart")
    launch.extend(["--registry", registry, agent])
    command = shlex.join(launch)
    windows.extend([
        f"  - window_name: {json.dumps(agent)}",
        "    panes:",
        f"      - shell_command: {json.dumps(command)}"
    ])

text = Path(source).read_text(encoding="utf-8")
text = text.replace("__SESSION_NAME__", json.dumps(session))
text = text.replace("__WORKDIR__", json.dumps(workdir))
text = text.replace("__TMUX_PREFIX__", json.dumps(prefix))
text = text.replace("# __AGENT_WINDOWS__", "\n".join(windows))
Path(destination).write_text(text, encoding="utf-8")
PY
}

run_tmux_workspace() {
  local status
  TMUX_RENDERED="$(mktemp "${TMPDIR:-/tmp}/dot-workspace.XXXXXX.yaml")"
  trap 'rm -f "$TMUX_RENDERED"' EXIT INT TERM
  render_tmux_workspace "$TMUX_RENDERED"
  if [[ "$PRINT_ONLY" == true ]]; then
    cat "$TMUX_RENDERED"
    return 0
  fi
  command -v uvx >/dev/null 2>&1 || {
    printf 'uvx is required; install the languages profile\n' >&2
    return 1
  }
  command -v tmux >/dev/null 2>&1 || {
    printf 'tmux is required; install the tmux profile\n' >&2
    return 1
  }
  local sessions existing
  # A failed listing with a live server is not evidence of absence.
  if tmux has-session 2>/dev/null; then
    sessions="$(tmux list-sessions -F '#{session_name}')" || return 1
    if grep -Fxq -- "$SESSION_NAME" <<<"$sessions"; then
      existing="$(tmux display-message -p -t "=$SESSION_NAME" '#{session_path}')" || return 1
      verify_workspace_directory "$existing" || return 1
      if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "=$SESSION_NAME"
      else
        tmux attach-session -t "=$SESSION_NAME"
      fi
      return
    fi
  fi
  export TMUXP_PROGRESS=0
  set +e
  uvx --from "tmuxp==${TMUXP_VERSION}" tmuxp load -y "$TMUX_RENDERED"
  status=$?
  set -e
  return "$status"
}

verify_workspace_directory() {
  local existing="$1" canonical
  canonical="$(cd -- "$existing" 2>/dev/null && pwd -P)" || canonical=""
  if [[ -z "$existing" || "$canonical" != "$WORKDIR" ]]; then
    printf 'Workspace name collision: %s\nExisting directory: %s\nRequested directory: %s\n' \
      "$SESSION_NAME" "${existing:-unknown}" "$WORKDIR" >&2
    return 1
  fi
}

run_herdr_json() {
  local output_name="$1" payload
  shift
  if ! payload="$(herdr "$@")"; then
    printf 'Herdr command failed: herdr %s\n' "$*" >&2
    return 1
  fi
  if jq -e '.error? != null' >/dev/null 2>&1 <<<"$payload"; then
    jq -r '.error.message // "unknown Herdr error"' <<<"$payload" >&2
    return 1
  fi
  printf -v "$output_name" '%s' "$payload"
}

ensure_herdr_server() {
  local state_root log_file server_pid
  if herdr workspace list >/dev/null 2>&1; then
    return 0
  fi
  if [[ "${HERDR_ENV:-}" == 1 ]]; then
    printf 'HERDR_ENV is set but the Herdr server is unreachable\n' >&2
    return 1
  fi

  state_root="${DOTFILES_STATE_DIR:-$HOME/.local/state/dotfiles}"
  log_file="$state_root/herdr-server-bootstrap.log"
  mkdir -p "$state_root"
  printf 'Starting Herdr server; log: %s\n' "$log_file"
  nohup herdr server </dev/null >>"$log_file" 2>&1 &
  server_pid=$!
  for _ in {1..100}; do
    if herdr workspace list >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  kill "$server_pid" 2>/dev/null || true
  printf 'Herdr server did not become ready; inspect %s\n' "$log_file" >&2
  return 1
}

run_herdr_workspace() {
  local list workspace_id created root_tab response placeholder_pane agent
  local -a launch_args
  if [[ "$PRINT_ONLY" == true ]]; then
    print_herdr_plan
    return 0
  fi
  command -v herdr >/dev/null 2>&1 || {
    printf 'herdr is required; install the tmux profile or choose --backend tmux\n' >&2
    return 1
  }
  command -v jq >/dev/null 2>&1 || {
    printf 'jq is required for Herdr workspace orchestration\n' >&2
    return 1
  }
  command -v dot-agent-launch >/dev/null 2>&1 || {
    printf 'dot-agent-launch is missing; apply the managed workspace commands\n' >&2
    return 1
  }
  ensure_herdr_server
  run_herdr_json list workspace list
  workspace_id="$(jq -r --arg label "$SESSION_NAME" \
    'first(.result.workspaces[]? | select(.label == $label) | .workspace_id) // empty' <<<"$list")"
  if [[ -n "$workspace_id" ]]; then
    existing_directory="$(jq -r --arg id "$workspace_id" \
      '.result.workspaces[] | select(.workspace_id == $id) | .cwd // empty' <<<"$list")"
    verify_workspace_directory "$existing_directory"
    herdr workspace focus "$workspace_id" >/dev/null
    printf 'Focused existing Herdr workspace: %s\n' "$SESSION_NAME"
  else
    run_herdr_json created workspace create --cwd "$WORKDIR" --label "$SESSION_NAME" --focus
    workspace_id="$(jq -er '.result.workspace.workspace_id' <<<"$created")"
    root_tab="$(jq -er '.result.tab.tab_id' <<<"$created")"
    if ! herdr tab rename "$root_tab" terminal >/dev/null; then
      herdr workspace close "$workspace_id" >/dev/null 2>&1 || true
      return 1
    fi

    for agent in "${AGENTS[@]}"; do
      if ! run_herdr_json response tab create --workspace "$workspace_id" \
        --cwd "$WORKDIR" --label "$agent" --no-focus; then
        herdr workspace close "$workspace_id" >/dev/null 2>&1 || true
        return 1
      fi
      placeholder_pane="$(jq -er '.result.root_pane.pane_id' <<<"$response")"
      launch_args=(dot-agent-launch)
      [[ "$RESTART_AGENTS" == true ]] && launch_args+=(--restart)
      launch_args+=(--registry "$REGISTRY" "$agent")
      launch_command=""
      printf -v launch_command '%q ' "${launch_args[@]}"
      launch_command="${launch_command% }"
      launch_command="DOTFILES_AGENT_REGISTRY=$(printf '%q' "$REGISTRY") $launch_command"
      if ! herdr pane run "$placeholder_pane" "$launch_command" >/dev/null; then
        herdr workspace close "$workspace_id" >/dev/null 2>&1 || true
        return 1
      fi
    done

    herdr tab focus "$root_tab" >/dev/null
    herdr workspace focus "$workspace_id" >/dev/null
    printf 'Created Herdr workspace %s with %d agents\n' "$SESSION_NAME" "${#AGENTS[@]}"
  fi

  if [[ "${HERDR_ENV:-}" != 1 ]]; then
    exec herdr
  fi
}

case "$BACKEND" in
  tmux) run_tmux_workspace ;;
  herdr) run_herdr_workspace ;;
esac
