#!/usr/bin/env bash
# Save and restore cloud CLI context identifiers without copying credentials.

set -euo pipefail

CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/cloud-contexts"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
AWS_ENV="$STATE_ROOT/cloud-context.env"
AWS_CACHE="$STATE_ROOT/cloud-context-aws.cache"
TEST_ROOT="$STATE_ROOT/cloud-context-test"
TEST_ENV="$STATE_ROOT/cloud-context-test.env"
TEST_SNAPSHOT="$TEST_ROOT/original-env"

usage() {
  cat <<'USAGE'
Usage: cloud-context [command]

  --status                  Show active provider contexts
  -s, --save NAME           Save current kubectl, gcloud, AWS, and Azure contexts
  -l, --load NAME           Activate a saved context profile through native CLIs
  -c, --clear [PROVIDER]    Clear one provider, or all providers when omitted
  -t, --test [PROVIDER]     Add an isolated fake context for one provider or all
      --test-clear [PROVIDER]
                            Remove one fake context or all fake contexts
  --list                    List saved profiles

Providers: kubectl, gcloud, aws, azure
USAGE
}

warn() { printf '[WARN] %s\n' "$*" >&2; }
info() { printf '[INFO] %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }
clean() { tr '\t\r\n' '   ' <<<"${1:-}" | sed 's/[[:space:]]*$//'; }
ensure_state_root() {
  umask 077
  mkdir -p "$STATE_ROOT"
  chmod 700 "$STATE_ROOT"
}

normalize_provider() {
  case "${1:-all}" in
    all) printf 'all\n' ;;
    kubectl | kube) printf 'kubectl\n' ;;
    gcloud | google) printf 'gcloud\n' ;;
    aws) printf 'aws\n' ;;
    azure | az) printf 'azure\n' ;;
    *)
      printf 'Unknown provider: %s\n' "$1" >&2
      exit 2
      ;;
  esac
}

validate_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    printf 'Invalid profile name: %s\n' "$1" >&2
    exit 2
  }
}

profile_path() {
  validate_name "$1"
  printf '%s/%s.tsv\n' "$CONFIG_ROOT" "$1"
}

read_value() {
  local file="$1" key="$2"
  awk -F '\t' -v key="$key" '$1 == key { print substr($0, index($0, "\t") + 1); exit }' "$file"
}

kubectl_context() {
  have kubectl && kubectl config current-context 2>/dev/null || true
}

gcloud_configuration() {
  have gcloud &&
    gcloud config configurations list --filter=is_active:true --format='value(name)' 2>/dev/null || true
}

gcloud_project() {
  local value
  value="$(have gcloud && gcloud config get-value project 2>/dev/null || true)"
  [[ "$value" != '(unset)' ]] && printf '%s\n' "$value"
}

aws_profile() {
  printf '%s\n' "${AWS_PROFILE:-${AWS_DEFAULT_PROFILE:-default}}"
}

aws_region() {
  local profile
  profile="$(aws_profile)"
  have aws && aws configure get region --profile "$profile" 2>/dev/null || true
}

aws_account() {
  if [[ -n "${CLOUD_CONTEXT_TEST_AWS_ACCOUNT:-}" ]]; then
    printf '%s\n' "$CLOUD_CONTEXT_TEST_AWS_ACCOUNT"
    return
  fi
  have aws || return 0
  timeout 1 aws sts get-caller-identity --query Account --output text 2>/dev/null || true
}

azure_value() {
  local query="$1"
  have az && az account show --query "$query" -o tsv 2>/dev/null || true
}

write_aws_env() {
  local profile="${1:-}" region="${2:-}"
  umask 077
  ensure_state_root
  {
    if [[ -n "$profile" && "$profile" != default ]]; then
      printf 'export AWS_PROFILE=%q\n' "$profile"
    else
      printf 'unset AWS_PROFILE\n'
    fi
    printf 'unset AWS_DEFAULT_PROFILE\n'
    if [[ -n "$region" ]]; then
      printf 'export AWS_DEFAULT_REGION=%q\n' "$region"
    else
      printf 'unset AWS_DEFAULT_REGION AWS_REGION\n'
    fi
  } >"$AWS_ENV"
  chmod 600 "$AWS_ENV"
  rm -f "$AWS_CACHE"
}

show_status() {
  local kube gconfig gproject aprofile aregion aaccount azname azid
  kube="$(clean "$(kubectl_context)")"
  gconfig="$(clean "$(gcloud_configuration)")"
  gproject="$(clean "$(gcloud_project)")"
  aprofile="$(clean "$(aws_profile)")"
  aregion="$(clean "$(aws_region)")"
  aaccount="$(clean "$(aws_account)")"
  azname="$(clean "$(azure_value name)")"
  azid="$(clean "$(azure_value id)")"
  printf 'kubectl  %s\n' "${kube:-<none>}"
  printf 'gcloud   %s%s\n' "${gproject:-<none>}" "${gconfig:+ (config: $gconfig)}"
  if [[ -n "$aaccount" ]]; then
    printf 'aws      %s (profile: %s%s)\n' "$aaccount" "$aprofile" "${aregion:+, region: $aregion}"
  else
    printf 'aws      <none>\n'
  fi
  printf 'azure    %s%s\n' "${azname:-<none>}" "${azid:+ ($azid)}"
}

save_profile() {
  local name="$1" file
  file="$(profile_path "$name")"
  umask 077
  mkdir -p "$CONFIG_ROOT"
  {
    printf 'kubectl_context\t%s\n' "$(clean "$(kubectl_context)")"
    printf 'gcloud_configuration\t%s\n' "$(clean "$(gcloud_configuration)")"
    printf 'gcloud_project\t%s\n' "$(clean "$(gcloud_project)")"
    printf 'aws_profile\t%s\n' "$(clean "$(aws_profile)")"
    printf 'aws_region\t%s\n' "$(clean "$(aws_region)")"
    printf 'azure_subscription\t%s\n' "$(clean "$(azure_value id)")"
  } >"$file"
  chmod 600 "$file"
  info "Saved cloud context profile '$name' (identifiers only)"
}

validate_profile_contexts() {
  local kube="$1" gconfig="$2" aprofile="$3" azure="$4"
  local failed=false

  if [[ -n "$kube" ]]; then
    if ! have kubectl; then
      warn "kubectl is required to load context '$kube'"
      failed=true
    elif ! kubectl config get-contexts "$kube" -o name 2>/dev/null | grep -Fxq "$kube"; then
      warn "kubectl context '$kube' does not exist locally"
      failed=true
    fi
  fi
  if [[ -n "$gconfig" ]]; then
    if ! have gcloud; then
      warn "gcloud is required to load configuration '$gconfig'"
      failed=true
    elif ! gcloud config configurations describe "$gconfig" \
      --format='value(name)' 2>/dev/null | grep -Fxq "$gconfig"; then
      warn "gcloud configuration '$gconfig' does not exist locally"
      failed=true
    fi
  fi
  if [[ -n "$aprofile" && "$aprofile" != default ]]; then
    if ! have aws; then
      warn "AWS CLI is required to load profile '$aprofile'"
      failed=true
    elif ! aws configure list-profiles 2>/dev/null | grep -Fxq "$aprofile"; then
      warn "AWS profile '$aprofile' does not exist locally"
      failed=true
    fi
  fi
  if [[ -n "$azure" ]]; then
    if ! have az; then
      warn "Azure CLI is required to load subscription '$azure'"
      failed=true
    elif ! az account list --query "[?id=='$azure'].id" -o tsv 2>/dev/null |
      grep -Fxq "$azure"; then
      warn "Azure subscription '$azure' is not available in the local account cache"
      failed=true
    fi
  fi

  [[ "$failed" == false ]]
}

load_profile() {
  local name="$1" file kube gconfig gproject aprofile aregion azure failed=false
  file="$(profile_path "$name")"
  [[ -r "$file" ]] || {
    printf 'Cloud context profile not found: %s\n' "$name" >&2
    exit 1
  }
  kube="$(read_value "$file" kubectl_context)"
  gconfig="$(read_value "$file" gcloud_configuration)"
  gproject="$(read_value "$file" gcloud_project)"
  aprofile="$(read_value "$file" aws_profile)"
  aregion="$(read_value "$file" aws_region)"
  azure="$(read_value "$file" azure_subscription)"

  validate_profile_contexts "$kube" "$gconfig" "$aprofile" "$azure" || {
    warn "Profile '$name' was not loaded; no contexts were changed"
    return 1
  }

  if [[ -n "$kube" ]]; then
    kubectl config use-context "$kube" >/dev/null ||
      {
        warn "kubectl context '$kube' could not be activated"
        failed=true
      }
  fi
  if [[ -n "$gconfig" ]]; then
    gcloud config configurations activate "$gconfig" --quiet >/dev/null ||
      {
        warn "gcloud configuration '$gconfig' could not be activated"
        failed=true
      }
  fi
  if [[ -n "$gproject" ]]; then
    gcloud config set project "$gproject" --quiet >/dev/null ||
      {
        warn "gcloud project '$gproject' could not be activated"
        failed=true
      }
  fi
  if [[ -n "$azure" ]]; then
    az account set --subscription "$azure" ||
      {
        warn "Azure subscription '$azure' could not be activated"
        failed=true
      }
  fi
  if [[ "$failed" == true ]]; then
    warn "Profile '$name' was only partially loaded; inspect cloud-context --status"
    return 1
  fi
  write_aws_env "$aprofile" "$aregion"
  info "Loaded cloud context profile '$name'"
  info "AWS selection is active in this shell through the Zsh cloud-context wrapper"
}

clear_provider() {
  case "$1" in
    kubectl | kube)
      have kubectl || {
        warn "kubectl is unavailable"
        return 1
      }
      kubectl config unset current-context >/dev/null ||
        {
          warn "kubectl is unavailable or has no current context"
          return 1
        }
      ;;
    gcloud | google)
      have gcloud || {
        warn "gcloud is unavailable"
        return 1
      }
      gcloud config unset project --quiet >/dev/null ||
        {
          warn "gcloud is unavailable or has no active project"
          return 1
        }
      ;;
    aws)
      write_aws_env "" ""
      ;;
    azure | az)
      have az || {
        warn "Azure CLI is unavailable"
        return 1
      }
      az account clear ||
        {
          warn "Azure CLI is unavailable or has no cached account context"
          return 1
        }
      ;;
    *)
      printf 'Unknown provider: %s\n' "$1" >&2
      exit 2
      ;;
  esac
}

clear_contexts() {
  local provider="${1:-all}" failed=false
  if [[ "$provider" == all ]]; then
    clear_provider kubectl || failed=true
    clear_provider gcloud || failed=true
    clear_provider aws || failed=true
    clear_provider azure || failed=true
    if [[ "$failed" == true ]]; then
      warn "Clear completed with unavailable or failed providers"
      return 1
    fi
    info "Cleared kubectl, gcloud, AWS, and Azure contexts through native interfaces"
  else
    clear_provider "$provider" || return
    info "Cleared $provider context through its native interface"
  fi
}

snapshot_test_environment() {
  local name
  [[ -r "$TEST_SNAPSHOT" ]] && return
  umask 077
  mkdir -p "$TEST_ROOT"
  : >"$TEST_SNAPSHOT"
  for name in \
    KUBECONFIG CLOUDSDK_CONFIG \
    AWS_PROFILE AWS_DEFAULT_PROFILE AWS_REGION AWS_DEFAULT_REGION \
    AWS_CONFIG_FILE AWS_SHARED_CREDENTIALS_FILE CLOUD_CONTEXT_TEST_AWS_ACCOUNT \
    AZURE_CONFIG_DIR; do
    if [[ -v "$name" ]]; then
      printf '%s\tset\t%s\n' "$name" "${!name}" >>"$TEST_SNAPSHOT"
    else
      printf '%s\tunset\t\n' "$name" >>"$TEST_SNAPSHOT"
    fi
  done
  chmod 600 "$TEST_SNAPSHOT"
}

write_test_fixtures() {
  mkdir -p \
    "$TEST_ROOT/kube" \
    "$TEST_ROOT/gcloud/configurations" \
    "$TEST_ROOT/aws" \
    "$TEST_ROOT/azure"
  cat >"$TEST_ROOT/kube/config" <<'EOF'
apiVersion: v1
current-context: cloud-context-test
contexts:
  - name: cloud-context-test
    context:
      cluster: cloud-context-test
      namespace: test
clusters:
  - name: cloud-context-test
    cluster:
      server: https://example.invalid
EOF
  printf 'test\n' >"$TEST_ROOT/gcloud/active_config"
  cat >"$TEST_ROOT/gcloud/configurations/config_test" <<'EOF'
[core]
project = cloud-context-test
[compute]
region = test-region
EOF
  cat >"$TEST_ROOT/aws/config" <<'EOF'
[profile cloud-context-test]
region = us-east-1
credential_process = /bin/false
EOF
  : >"$TEST_ROOT/aws/credentials"
  cat >"$TEST_ROOT/azure/azureProfile.json" <<'EOF'
{"installationId":"cloud-context-test","subscriptions":[{"id":"00000000-0000-0000-0000-000000000042","name":"Cloud Context Test","tenantId":"00000000-0000-0000-0000-000000000043","state":"Enabled","user":{"name":"test@example.invalid","type":"user"},"isDefault":true}]}
EOF
  chmod -R go-rwx "$TEST_ROOT"
}

restore_test_variable() {
  local name="$1" state value
  IFS=$'\t' read -r _ state value < <(
    awk -F '\t' -v key="$name" '$1 == key { print; exit }' "$TEST_SNAPSHOT"
  )
  if [[ "$state" == set ]]; then
    printf 'export %s=%q\n' "$name" "$value"
  else
    printf 'unset %s\n' "$name"
  fi
}

write_test_environment() {
  local name
  local -a enabled
  umask 077
  ensure_state_root
  shopt -s nullglob
  enabled=("$TEST_ROOT"/enabled-*)
  shopt -u nullglob
  if ((${#enabled[@]})); then
    touch "$TEST_ROOT/active"
  else
    rm -f "$TEST_ROOT/active"
  fi
  {
    printf '# Generated by cloud-context --test; source through the shell wrapper.\n'
    for name in \
      KUBECONFIG CLOUDSDK_CONFIG \
      AWS_PROFILE AWS_DEFAULT_PROFILE AWS_REGION AWS_DEFAULT_REGION \
      AWS_CONFIG_FILE AWS_SHARED_CREDENTIALS_FILE CLOUD_CONTEXT_TEST_AWS_ACCOUNT \
      AZURE_CONFIG_DIR; do
      restore_test_variable "$name"
    done
    if [[ -e "$TEST_ROOT/enabled-kubectl" ]]; then
      printf 'export KUBECONFIG=%q\n' "$TEST_ROOT/kube/config"
    fi
    if [[ -e "$TEST_ROOT/enabled-gcloud" ]]; then
      printf 'export CLOUDSDK_CONFIG=%q\n' "$TEST_ROOT/gcloud"
    fi
    if [[ -e "$TEST_ROOT/enabled-aws" ]]; then
      printf 'export AWS_PROFILE=cloud-context-test\n'
      printf 'unset AWS_DEFAULT_PROFILE AWS_REGION\n'
      printf 'export AWS_DEFAULT_REGION=us-east-1\n'
      printf 'export AWS_CONFIG_FILE=%q\n' "$TEST_ROOT/aws/config"
      printf 'export AWS_SHARED_CREDENTIALS_FILE=%q\n' "$TEST_ROOT/aws/credentials"
      printf 'export CLOUD_CONTEXT_TEST_AWS_ACCOUNT=000000000042\n'
    fi
    if [[ -e "$TEST_ROOT/enabled-azure" ]]; then
      printf 'export AZURE_CONFIG_DIR=%q\n' "$TEST_ROOT/azure"
    fi
  } >"$TEST_ENV"
  chmod 600 "$TEST_ENV"
  rm -f "$AWS_CACHE"
}

test_contexts() {
  local provider
  provider="$(normalize_provider "${1:-all}")"
  snapshot_test_environment
  write_test_fixtures
  if [[ "$provider" == all ]]; then
    touch "$TEST_ROOT/enabled-kubectl" "$TEST_ROOT/enabled-gcloud" \
      "$TEST_ROOT/enabled-aws" "$TEST_ROOT/enabled-azure"
  else
    touch "$TEST_ROOT/enabled-$provider"
  fi
  write_test_environment
  info "Enabled isolated fake ${provider/all/all providers} context"
  info "The Zsh wrapper applies it to this shell; use cloud-context --test-clear"
}

clear_test_contexts() {
  local provider
  provider="$(normalize_provider "${1:-all}")"
  [[ -r "$TEST_SNAPSHOT" ]] || {
    info "No fake cloud contexts are active"
    return
  }
  if [[ "$provider" == all ]]; then
    rm -f "$TEST_ROOT"/enabled-*
  else
    rm -f "$TEST_ROOT/enabled-$provider"
  fi
  write_test_environment
  info "Removed isolated fake ${provider/all/all providers} context"
}

prompt_aws() {
  local now profile cached_at cached_profile cached_account account
  if [[ -n "${CLOUD_CONTEXT_TEST_AWS_ACCOUNT:-}" ]]; then
    [[ "$CLOUD_CONTEXT_TEST_AWS_ACCOUNT" =~ ^[0-9]{12}$ ]] || return 1
    printf '%s\n' "$CLOUD_CONTEXT_TEST_AWS_ACCOUNT"
    return
  fi
  have aws || return 1
  profile="$(aws_profile)"
  now="$(date +%s)"
  if [[ -r "$AWS_CACHE" ]]; then
    IFS=$'\t' read -r cached_at cached_profile cached_account <"$AWS_CACHE" || true
    if [[ "$cached_profile" == "$profile" && "$cached_at" =~ ^[0-9]+$ &&
      $((now - cached_at)) -lt 300 ]]; then
      [[ "$cached_account" != - ]] && printf '%s\n' "$cached_account"
      [[ "$cached_account" != - ]]
      return
    fi
  fi
  account="$(aws_account)"
  [[ "$account" =~ ^[0-9]{12}$ ]] || account=-
  umask 077
  ensure_state_root
  printf '%s\t%s\t%s\n' "$now" "$profile" "$account" >"$AWS_CACHE"
  chmod 600 "$AWS_CACHE"
  if [[ "$account" != - ]]; then
    printf '%s\n' "$account"
  else
    return 1
  fi
}

shorten_prompt_label() {
  local value="$1" max="${2:-28}" head tail
  [[ "$max" =~ ^[0-9]+$ && "$max" -ge 16 ]] || max=28
  if ((${#value} <= max)); then
    printf '%s\n' "$value"
    return
  fi
  head=$((max / 3))
  tail=$((max - head - 3))
  printf '%s...%s\n' "${value:0:head}" "${value: -tail}"
}

prompt_kubectl() {
  local context namespace output
  context="$(clean "$(kubectl_context)")"
  [[ -n "$context" ]] || return 1
  output="$(shorten_prompt_label "$context" "${CLOUD_CONTEXT_MAX_LENGTH:-28}")"
  namespace="$(
    kubectl config view --minify --output 'jsonpath={..namespace}' 2>/dev/null || true
  )"
  if [[ -n "$namespace" && "$namespace" != default ]]; then
    printf '%s (%s)\n' "$output" "$(clean "$namespace")"
  else
    printf '%s\n' "$output"
  fi
}

case "${1:---status}" in
  --status | status) show_status ;;
  -s | --save)
    [[ -n "${2:-}" ]] || {
      usage >&2
      exit 2
    }
    save_profile "$2"
    ;;
  -l | --load)
    [[ -n "${2:-}" ]] || {
      usage >&2
      exit 2
    }
    load_profile "$2"
    ;;
  -c | --clear) clear_contexts "${2:-all}" ;;
  -t | --test) test_contexts "${2:-all}" ;;
  --test-clear) clear_test_contexts "${2:-all}" ;;
  --list | list)
    [[ -d "$CONFIG_ROOT" ]] &&
      find "$CONFIG_ROOT" -maxdepth 1 -type f -name '*.tsv' -printf '%f\n' |
      sed 's/\.tsv$//' | sort
    ;;
  prompt)
    case "${2:-}" in
      aws) prompt_aws ;;
      kubectl | kube) prompt_kubectl ;;
      *) exit 2 ;;
    esac
    ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
