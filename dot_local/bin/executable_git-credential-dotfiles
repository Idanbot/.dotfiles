#!/usr/bin/env bash
# Select a usable GCM for non-GitHub hosts without fragile config shell code.

set -euo pipefail

windows_gcm="${GCM_WINDOWS_PATH:-/mnt/c/Program Files/Git/mingw64/bin/git-credential-manager.exe}"
if [[ -x "$windows_gcm" ]]; then
  exec "$windows_gcm" "$@"
fi
if command -v git-credential-manager >/dev/null 2>&1; then
  exec git-credential-manager "$@"
fi
if command -v git-credential-manager-core >/dev/null 2>&1; then
  exec git-credential-manager-core "$@"
fi

# No helper means Git can fall back to its normal interactive credential prompt.
exit 0
