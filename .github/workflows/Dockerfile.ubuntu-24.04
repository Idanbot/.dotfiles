FROM ubuntu:24.04

# Avoid interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install base dependencies
# Package versions intentionally follow ubuntu:24.04 patch updates in CI.
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      sudo \
      curl \
      git \
      ca-certificates \
      locales \
      fontconfig \
      jq \
      procps \
      tzdata \
    && rm -rf /var/lib/apt/lists/*

# Set up locale
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Create test user with sudo
RUN groupadd --gid 10000 testuser && \
    useradd --uid 10000 --gid 10000 --create-home --shell /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER 10000:10000
WORKDIR /home/testuser
ENV HOME="/home/testuser"

# Ensure ~/.local/bin is on PATH
ENV PATH="/home/testuser/.local/bin:${PATH}"
ENV DOTFILES_CI=true
ENV DOTFILES_COLOR=always
