FROM ubuntu:24.04 AS base

# Avoid interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install base dependencies
# Package versions intentionally follow ubuntu:24.04 patch updates in CI.
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      sudo \
      curl \
      git \
      ca-certificates \
      locales \
      fontconfig \
      jq \
      procps \
      tzdata \
    && rm -rf /var/lib/apt/lists/*

# Set up locale
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Create test user with sudo
RUN groupadd --gid 10000 testuser && \
    useradd --uid 10000 --gid 10000 --create-home --shell /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER 10000:10000
WORKDIR /home/testuser
ENV HOME="/home/testuser"

# Ensure ~/.local/bin is on PATH
ENV PATH="/home/testuser/.local/bin:${PATH}"
ENV DOTFILES_CI=true
ENV DOTFILES_COLOR=always

# Validators live in a separate target; live installs start from the minimal base.
FROM base AS tests
USER root
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-yaml yq gojq zsh tmux openssh-client \
      xz-utils gnupg shellcheck yamllint gawk hyperfine fzf unzip pigz zstd \
      kcat pgloader golang-go \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-audit.txt /tmp/requirements-audit.txt
RUN python3 -m venv /opt/validators && \
    /opt/validators/bin/pip install --no-cache-dir -r /tmp/requirements-audit.txt \
      PyYAML==6.0.3 ruff==0.14.2 zizmor==1.26.1
ENV PATH="/opt/validators/bin:/home/testuser/.local/bin:${PATH}"
USER 10000:10000
RUN go install mvdan.cc/sh/v3/cmd/shfmt@v3.13.1 && \
    go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12
ENV PATH="/home/testuser/go/bin:${PATH}"
