# ~/.profile: executed by the command interpreter for login shells.

[ -r "$HOME/.config/dotfiles/privacy.sh" ] && . "$HOME/.config/dotfiles/privacy.sh"

if [ -n "$BASH_VERSION" ]; then
  if [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
  fi
fi

# User paths
if [ -d "$HOME/bin" ]; then
  PATH="$HOME/bin:$PATH"
fi

if [ -d "$HOME/.local/bin" ]; then
  PATH="$HOME/.local/bin:$PATH"
fi

# Rust
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# uv / pip
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# Node.js shims and npm global tools managed by the bootstrap.
PATH="$HOME/.local/share/npm/bin:$PATH"
export PATH

# Go
export PATH="$PATH:/usr/local/go/bin"

# Do not shadow a newer or externally managed Java installation.
if [ -z "${JAVA_HOME:-}" ] && [ -x "$HOME/.local/share/dotfiles/tools/java/current/bin/java" ] &&
  command -v java >/dev/null 2>&1 &&
  [ "$(readlink -f "$(command -v java)")" = "$(readlink -f "$HOME/.local/share/dotfiles/tools/java/current/bin/java")" ]; then
  export JAVA_HOME="$HOME/.local/share/dotfiles/tools/java/current"
fi
