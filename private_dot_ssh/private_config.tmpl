# SSH Client Configuration
# Auto-generated by chezmoi from {{ .chezmoi.sourceFile }}
# DO NOT EDIT DIRECTLY. Your changes will be overwritten.

Include ~/.ssh/config.local

# Global Defaults
Host *
    # Cache unlocked keys in the active agent for eight hours, never on disk.
    AddKeysToAgent 8h
    # Keep connections alive in background
    ServerAliveInterval 60
    ServerAliveCountMax 10
    # Enable connection multiplexing (faster subsequent connections)
    ControlMaster auto
    # %C hashes connection details and avoids Unix socket path-length failures.
    ControlPath ~/.ssh/cm-%C
    ControlPersist 600
    UpdateHostKeys yes

# GitHub
Host github.com
    HostName github.com
    User git

# GitLab
Host gitlab.com
    HostName gitlab.com
    User git

# Raspberry Pi 4 (Cloudflare Access SSH)
Host rpi4
    HostName rpi4-ssh.idanbot.uk
    User idan
    IdentitiesOnly yes
    PreferredAuthentications publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    ConnectTimeout 15
    ProxyCommand %d/.local/bin/cloudflare-ssh proxy %h

# ThinkPad T420 (Cloudflare Access SSH)
Host t420
    HostName t420.idanbot.uk
    User idan
    IdentitiesOnly yes
    PreferredAuthentications publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    ConnectTimeout 15
    ProxyCommand %d/.local/bin/cloudflare-ssh proxy %h

