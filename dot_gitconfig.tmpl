[user]
	email = {{ .email }}
	name = {{ .name }}
[credential]
	# Reset inherited helpers, then use a real executable instead of fragile shell in config.
	helper =
	helper = dotfiles
{{ if not .is_wsl }}
	credentialStore = secretservice
{{- end }}
[credential "https://dev.azure.com"]
	useHttpPath = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true
[diff]
	tool = nvimdiff
[merge]
	tool = nvimdiff
[include]
	path = ~/.config/git/config.local
