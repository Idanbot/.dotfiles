#!/usr/bin/env bash
if [[ -z "${DOTFILES_SOURCE_DIR:-}" ]]; then
  DOTFILES_SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
fi
# shellcheck source=scripts/lib.sh
source "$DOTFILES_SOURCE_DIR/scripts/lib.sh"

log_step "Installing AI Coding Tools"
activate_node_paths
if ! is_installed npm; then
  log_error "npm is required for the pinned agent packages; include the languages section"
  exit 1
fi

LEGACY_GEMINI_PATH="$(npm_global_prefix)/lib/node_modules/@google/gemini-cli"
if [[ -d "$LEGACY_GEMINI_PATH" ]]; then
  log_info "Removing the deprecated managed Gemini CLI"
  npm uninstall --global --prefix "$(npm_global_prefix)" @google/gemini-cli
  forget_install gemini
  log_success "Deprecated Gemini CLI removed"
else
  forget_install gemini
fi

CLAUDE_VERSION="$(package_version ai_tools claude_cli 2.1.206)"
npm_install_global @anthropic-ai/claude-code "$CLAUDE_VERSION" claude @anthropic-ai/claude-code

CODEX_INSTALLER_SHA="$(package_metadata ai_tools codex_cli sha256)"
CODEX_PATH="$(command -v codex 2>/dev/null || true)"
if [[ -z "$CODEX_PATH" || "$CODEX_PATH" == "$HOME/.nvm/"* ]]; then
  tmpdir="$(mktemp -d)"
  log_info "Installing Codex CLI with OpenAI's standalone installer"
  download_verified \
    https://chatgpt.com/codex/install.sh "$tmpdir/codex-install.sh" \
    "sha256:$CODEX_INSTALLER_SHA" codex-install.sh
  retry_command "Codex standalone installer" 4 5 \
    env CODEX_NON_INTERACTIVE=1 sh "$tmpdir/codex-install.sh"
  rm -rf "$tmpdir"
  export PATH="$HOME/.local/bin:$PATH"
  is_installed codex || {
    log_error "Codex standalone installer did not expose codex in PATH"
    exit 1
  }
  record_install codex "$(codex --version 2>/dev/null | head -1 || printf standalone)" openai-installer "$(command -v codex)"
  ((_INSTALLED++)) || true
  log_success "Codex standalone CLI installed"
else
  log_skip "Codex standalone CLI already installed"
fi

ANTIGRAVITY_INSTALLER_SHA="$(package_metadata ai_tools antigravity_cli sha256)"
if is_installed agy; then
  log_skip "Antigravity CLI already installed"
else
  tmpdir="$(mktemp -d)"
  install_home="$HOME"
  mkdir -p "$tmpdir/home"
  log_info "Installing Antigravity CLI with Google's standalone installer"
  download_verified \
    https://antigravity.google/cli/install.sh "$tmpdir/antigravity-install.sh" \
    "sha256:$ANTIGRAVITY_INSTALLER_SHA" antigravity-install.sh
  # Contain the vendor's shell-profile edits; chezmoi already manages PATH.
  retry_command "Antigravity standalone installer" 4 5 \
    env HOME="$tmpdir/home" bash "$tmpdir/antigravity-install.sh" \
    --dir "$install_home/.local/bin"
  rm -rf "$tmpdir"
  export PATH="$HOME/.local/bin:$PATH"
  is_installed agy || {
    log_error "Antigravity standalone installer did not expose agy in PATH"
    exit 1
  }
  record_install antigravity "$(agy --version 2>/dev/null | head -1 || printf standalone)" \
    google-installer "$(command -v agy)"
  ((_INSTALLED++)) || true
  log_success "Antigravity standalone CLI installed"
fi

OPENCODE_VERSION="$(package_version ai_tools opencode 1.17.18)"
npm_install_global opencode-ai "$OPENCODE_VERSION" opencode opencode-ai

OMP_VERSION="$(package_version ai_tools omp 16.4.0)"
case "$(get_arch)" in
  amd64)
    OMP_ASSET=omp-linux-x64
    ;;
  arm64)
    OMP_ASSET=omp-linux-arm64
    ;;
esac
OMP_SHA256="$(package_metadata ai_tools omp "sha256_$(get_arch)")"
install_github_binary omp can1357/oh-my-pi "v$OMP_VERSION" "$OMP_ASSET" omp \
  "sha256:$OMP_SHA256" 'omp --version'

SERENA_VERSION="$(package_version ai_tools serena 1.6.1)"
if ! is_installed serena ||
  ! version_ge "$(serena --version 2>/dev/null || true)" "$SERENA_VERSION"; then
  log_info "Installing optional Serena MCP runtime $SERENA_VERSION"
  uv tool install --force -p 3.13 "serena-agent==${SERENA_VERSION}"
  record_install serena "$SERENA_VERSION" uv:serena-agent \
    "$HOME/.local/share/uv/tools/serena-agent"
  ((_INSTALLED++)) || true
  log_success "Serena $SERENA_VERSION installed"
else
  log_skip "Serena $SERENA_VERSION already installed or newer"
fi
if [[ ! -f "$HOME/.serena/serena_config.yml" ]]; then
  log_info "Initializing Serena's local language-server configuration"
  serena init
fi

CONTEXT_MODE_VERSION="$(package_version ai_tools context_mode 1.0.169)"
npm_install_global context-mode "$CONTEXT_MODE_VERSION" context-mode \
  context-mode,better-sqlite3

GRAPHIFY_VERSION="$(package_version ai_tools graphify 0.9.38)"
if ! is_installed graphify ||
  ! version_ge "$(graphify --version 2>/dev/null || true)" "$GRAPHIFY_VERSION"; then
  log_info "Installing optional Graphify skill runtime $GRAPHIFY_VERSION"
  uv tool install --force -p 3.13 "graphifyy==${GRAPHIFY_VERSION}"
  record_install graphify "$GRAPHIFY_VERSION" uv:graphifyy \
    "$HOME/.local/share/uv/tools/graphifyy"
  ((_INSTALLED++)) || true
  log_success "Graphify $GRAPHIFY_VERSION installed"
else
  log_skip "Graphify $GRAPHIFY_VERSION already installed or newer"
fi

# OMP discovers the standard Agent Skills location. Registration is passive:
# no repository graph, hook, MCP server, or external backend is configured.
if graphify install --platform agents >/dev/null; then
  log_success "Graphify skill registered for OMP"
else
  log_error "Graphify skill registration failed"
fi

for agent in claude codex agy opencode omp; do
  if version_output="$("$agent" --version 2>&1)"; then
    log_success "$agent executable validation passed"
  else
    log_error "$agent failed its noninteractive version check: ${version_output:-no output}"
  fi
done

for mcp_runtime in serena context-mode agent-mcp; do
  if is_installed "$mcp_runtime"; then
    log_success "$mcp_runtime optional runtime is available"
  else
    log_error "$mcp_runtime optional runtime is unavailable"
  fi
done
log_info "Optional MCP servers are disabled by default; use 'agent-mcp enable <server>'"
log_info "Graphify is available on demand in OMP; run '/graphify .' inside an agent session"

if is_installed herdr; then
  log_info "Installing bundled Herdr agent integrations"
  for integration in claude codex opencode omp; do
    if herdr integration install "$integration" >/dev/null 2>&1; then
      log_success "Herdr $integration integration installed"
    else
      log_warn "Herdr $integration integration could not be installed; run 'herdr integration install $integration' manually"
    fi
  done
else
  log_warn "Herdr is unavailable; agent integrations were not installed"
fi
log_info "Agent authentication and session state are intentionally left to the user"

print_summary "AI Coding Tools"
