#!/usr/bin/env bash
if [[ -z "${DOTFILES_SOURCE_DIR:-}" ]]; then
  DOTFILES_SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
fi
# shellcheck source=scripts/lib.sh
source "$DOTFILES_SOURCE_DIR/scripts/lib.sh"

log_step "Installing Nerd Fonts"
FONT_NAME="$(package_version fonts nerd_font FiraMono)"
FONT_VERSION="$(package_version fonts nerd_font_version 3.4.0)"
FONT_DIR="$HOME/.local/share/fonts/$FONT_NAME"
FONT_INSTALLED=""
if [[ -r "$(managed_state_root)/installed.tsv" ]]; then
  FONT_INSTALLED="$(awk -F '\t' -v target="$FONT_DIR" '$3 == "nerd-fonts" && $4 == target { print $2; exit }' "$(managed_state_root)/installed.tsv")"
fi

if [[ -z "$FONT_INSTALLED" ]] && { nerd_font_registered "$FONT_NAME" || nerd_font_files_present "$FONT_NAME" "$FONT_DIR"; }; then
  log_skip "Preserving externally installed $FONT_NAME Nerd Font (version not managed)"
elif [[ "$FONT_INSTALLED" == "$FONT_VERSION" ]] && nerd_font_files_present "$FONT_NAME" "$FONT_DIR"; then
  assert_owned_target "$FONT_DIR"
  log_info "Rebuilding fontconfig cache for $FONT_NAME Nerd Font"
  fc-cache -f "$FONT_DIR" >/dev/null 2>&1 || true
  if nerd_font_registered "$FONT_NAME"; then
    log_success "$FONT_NAME Nerd Font cache repaired"
  else
    log_warn "$FONT_NAME Nerd Font files are installed but fontconfig did not index them"
  fi
else
  tmpdir="$(mktemp -d)"
  trap 'rm -rf -- "$tmpdir"' EXIT
  asset="${FONT_NAME}.zip"
  log_info "Installing $FONT_NAME Nerd Font $FONT_VERSION"
  download_verified \
    "https://github.com/ryanoasis/nerd-fonts/releases/download/v${FONT_VERSION}/$asset" \
    "$tmpdir/$asset" \
    "https://github.com/ryanoasis/nerd-fonts/releases/download/v${FONT_VERSION}/SHA-256.txt" \
    "$asset"
  mkdir -p "$tmpdir/fonts"
  unzip -qo "$tmpdir/$asset" -d "$tmpdir/fonts"
  font_probe() { nerd_font_files_present "$FONT_NAME" "$1"; }
  install_managed_app "$tmpdir/fonts" "$FONT_DIR" "$FONT_NAME" "$FONT_VERSION" nerd-fonts font_probe
  rm -rf "$tmpdir"
  fc-cache -f "$FONT_DIR" >/dev/null 2>&1 || true
  ((_INSTALLED++)) || true
  log_success "$FONT_NAME Nerd Font installed"
fi

print_summary "Nerd Fonts"
