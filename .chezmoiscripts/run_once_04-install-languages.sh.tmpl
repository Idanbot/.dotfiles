#!/usr/bin/env bash
if [[ -z "${DOTFILES_SOURCE_DIR:-}" ]]; then
  DOTFILES_SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
fi
# shellcheck source=scripts/lib.sh
source "$DOTFILES_SOURCE_DIR/scripts/lib.sh"

log_step "Installing Languages & Runtimes"
require_sudo
ARCH="$(get_arch)"

GO_VERSION="$(package_version languages go 1.26.5)"
GO_ROOT="$HOME/.local/share/dotfiles/tools/go/$GO_VERSION"
if ! is_installed go || ! version_ge "$(go version 2>/dev/null || true)" "$GO_VERSION"; then
  tmpdir="$(mktemp -d)"
  asset="go${GO_VERSION}.linux-${ARCH}.tar.gz"
  go_sha256="$(go_release_checksum "$asset")"
  log_info "Installing Go $GO_VERSION"
  download_verified \
    "https://go.dev/dl/$asset" "$tmpdir/$asset" \
    "sha256:$go_sha256" "$asset"
  tar -C "$tmpdir" -xzf "$tmpdir/$asset"
  install_managed_tree "$tmpdir/go" "$GO_ROOT" go "$GO_VERSION" go-dist bin/go version
  export PATH="$GO_ROOT/bin:$PATH"
  rm -rf "$tmpdir"
  ((_INSTALLED++)) || true
  log_success "Go $GO_VERSION installed"
else
  log_skip "Go $GO_VERSION already installed or newer"
fi
GO_BIN_DIR="$(dirname "$(readlink -f "$(command -v go)")")"
for binary in go gofmt; do
  [[ -x "$GO_BIN_DIR/$binary" ]] &&
    managed_link "$GO_BIN_DIR/$binary" "$HOME/.local/bin/$binary" go "$GO_VERSION"
done

RUST_CHANNEL="$(package_version languages rust 1.97.1)"
if ! is_installed rustup; then
  case "$ARCH" in
    amd64) RUST_TARGET=x86_64-unknown-linux-gnu ;;
    arm64) RUST_TARGET=aarch64-unknown-linux-gnu ;;
    *)
      log_error "Unsupported rustup architecture: $ARCH"
      exit 1
      ;;
  esac
  tmpdir="$(mktemp -d)"
  rustup_url="https://static.rust-lang.org/rustup/dist/${RUST_TARGET}/rustup-init"
  log_info "Installing Rust toolchain $RUST_CHANNEL"
  download_verified "$rustup_url" "$tmpdir/rustup-init" "$rustup_url.sha256" rustup-init
  chmod +x "$tmpdir/rustup-init"
  "$tmpdir/rustup-init" -y --default-toolchain "$RUST_CHANNEL" --profile minimal
  rm -rf "$tmpdir"
  record_install rustup "$RUST_CHANNEL" rustup "$HOME/.cargo"
  ((_INSTALLED++)) || true
  log_success "Rust installed"
else
  log_skip "Rustup already installed"
fi
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
rustup toolchain install "$RUST_CHANNEL" --profile minimal
rustup default "$RUST_CHANNEL"
for binary in rustup cargo rustc rustdoc rustfmt clippy; do
  [[ -x "$HOME/.cargo/bin/$binary" ]] &&
    managed_link "$HOME/.cargo/bin/$binary" "$HOME/.local/bin/$binary" rust "$RUST_CHANNEL"
done

NODE_VERSION="$(package_version languages node 26.5.0)"
case "$ARCH" in
  amd64) NODE_ARCH=x64 ;;
  arm64) NODE_ARCH=arm64 ;;
  *)
    log_error "Unsupported Node.js architecture: $ARCH"
    exit 1
    ;;
esac
NODE_ROOT="$HOME/.local/share/dotfiles/tools/node/$NODE_VERSION"
NODE_ASSET="node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz"
if [[ ! -x "$NODE_ROOT/bin/node" ]] || ! version_ge "$($NODE_ROOT/bin/node --version 2>/dev/null || true)" "$NODE_VERSION"; then
  tmpdir="$(mktemp -d)"
  log_info "Installing Node.js $NODE_VERSION into a stable user-local runtime"
  download_verified \
    "https://nodejs.org/dist/v${NODE_VERSION}/${NODE_ASSET}" "$tmpdir/$NODE_ASSET" \
    "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" "$NODE_ASSET"
  mkdir -p "$tmpdir/runtime"
  tar -xJf "$tmpdir/$NODE_ASSET" -C "$tmpdir/runtime" --strip-components=1
  install_managed_tree "$tmpdir/runtime" "$NODE_ROOT" node "$NODE_VERSION" node-dist bin/node --version
  rm -rf "$tmpdir"
  ((_INSTALLED++)) || true
  log_success "Node.js $NODE_VERSION installed"
else
  log_skip "Node.js $NODE_VERSION runtime already installed"
fi
export PATH="$NODE_ROOT/bin:$PATH"
activate_node_paths
NPM_VERSION="$(package_version languages npm 12.0.1)"
if [[ "$("$NODE_ROOT/bin/npm" --version 2>/dev/null || true)" != "$NPM_VERSION" ]]; then
  log_info "Installing npm $NPM_VERSION into the managed Node.js runtime"
  assert_owned_target "$NODE_ROOT"
  tmpdir="$(mktemp -d)"
  cp -a "$NODE_ROOT" "$tmpdir/runtime"
  PATH="$tmpdir/runtime/bin:$PATH" "$tmpdir/runtime/bin/npm" \
    install --global --prefix "$tmpdir/runtime" --no-audit --no-fund "npm@$NPM_VERSION"
  [[ "$(PATH="$tmpdir/runtime/bin:$PATH" "$tmpdir/runtime/bin/npm" --version)" == "$NPM_VERSION" ]]
  install_managed_tree "$tmpdir/runtime" "$NODE_ROOT" node "$NODE_VERSION" node-dist bin/node --version
  rm -rf "$tmpdir"
  record_install npm "$NPM_VERSION" npm "$NODE_ROOT/lib/node_modules/npm"
  ((_INSTALLED++)) || true
  log_success "npm $NPM_VERSION installed"
else
  log_skip "npm $NPM_VERSION already installed"
fi
for binary in node npm npx corepack; do
  [[ -x "$NODE_ROOT/bin/$binary" ]] && managed_link "$NODE_ROOT/bin/$binary" "$HOME/.local/bin/$binary" node "$NODE_VERSION"
done
if ! is_installed node || ! is_installed npm ||
  [[ "$(npm --version 2>/dev/null || true)" != "$NPM_VERSION" ]]; then
  log_error "Node.js/npm shims are unavailable after installation"
  exit 1
fi

TYPESCRIPT_VERSION="$(package_version languages typescript 7.0.2)"
npm_install_global typescript "$TYPESCRIPT_VERSION" tsc

UV_VERSION="$(package_version languages uv 0.11.28)"
if ! is_installed uv || ! version_ge "$(uv --version 2>/dev/null || true)" "$UV_VERSION"; then
  case "$ARCH" in
    amd64) UV_TARGET=x86_64-unknown-linux-gnu ;;
    arm64) UV_TARGET=aarch64-unknown-linux-gnu ;;
  esac
  tmpdir="$(mktemp -d)"
  asset="uv-${UV_TARGET}.tar.gz"
  log_info "Installing uv $UV_VERSION"
  download_verified \
    "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/$asset" "$tmpdir/$asset" \
    "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/$asset.sha256" "$asset"
  tar -xzf "$tmpdir/$asset" -C "$tmpdir"
  install_managed_binary "$tmpdir/uv-${UV_TARGET}/uv" uv "$UV_VERSION" github:astral-sh/uv
  install_managed_binary "$tmpdir/uv-${UV_TARGET}/uvx" uvx "$UV_VERSION" github:astral-sh/uv
  rm -rf "$tmpdir"
  ((_INSTALLED++)) || true
  log_success "uv $UV_VERSION installed"
else
  log_skip "uv $UV_VERSION already installed or newer"
fi
export PATH="$HOME/.local/bin:$PATH"

PYTHON_VERSION="$(package_version languages python 3.14.6)"
if uv python find "$PYTHON_VERSION" >/dev/null 2>&1; then
  log_skip "Python $PYTHON_VERSION already installed"
else
  log_info "Installing Python $PYTHON_VERSION with uv"
  uv python install "$PYTHON_VERSION"
  record_install python "$PYTHON_VERSION" uv-python "$PYTHON_VERSION"
  ((_INSTALLED++)) || true
  log_success "Python $PYTHON_VERSION installed"
fi

JAVA_VERSION="$(package_version languages java 25.0.3+9)"
JAVA_MAJOR="${JAVA_VERSION%%.*}"
JAVA_BUILD="${JAVA_VERSION#*+}"
JAVA_FILE_VERSION="${JAVA_VERSION%%+*}_${JAVA_BUILD}"
case "$ARCH" in
  amd64) JAVA_ARCH=x64 ;;
  arm64) JAVA_ARCH=aarch64 ;;
esac
JAVA_ROOT="$HOME/.local/share/dotfiles/tools/java/$JAVA_VERSION"
JAVA_CURRENT="$HOME/.local/share/dotfiles/tools/java/current"
if [[ ! -x "$JAVA_ROOT/bin/java" ]] ||
  ! version_major_matches "$("$JAVA_ROOT/bin/java" -version 2>&1 | head -1 || true)" "$JAVA_MAJOR"; then
  tmpdir="$(mktemp -d)"
  asset="OpenJDK${JAVA_MAJOR}U-jdk_${JAVA_ARCH}_linux_hotspot_${JAVA_FILE_VERSION}.tar.gz"
  JAVA_SHA="$(package_metadata languages java "sha256_$ARCH")"
  log_info "Installing Eclipse Temurin JDK $JAVA_VERSION"
  download_verified \
    "https://github.com/adoptium/temurin${JAVA_MAJOR}-binaries/releases/download/jdk-${JAVA_VERSION/+/%2B}/$asset" \
    "$tmpdir/$asset" "sha256:$JAVA_SHA" "$asset"
  mkdir -p "$tmpdir/runtime"
  tar -xzf "$tmpdir/$asset" -C "$tmpdir/runtime" --strip-components=1
  install_managed_tree "$tmpdir/runtime" "$JAVA_ROOT" java "$JAVA_VERSION" adoptium bin/java -version
  rm -rf "$tmpdir"
  ((_INSTALLED++)) || true
  log_success "Eclipse Temurin JDK $JAVA_VERSION installed"
else
  log_skip "Eclipse Temurin JDK $JAVA_VERSION already installed"
fi
managed_link "$JAVA_ROOT" "$JAVA_CURRENT" java "$JAVA_VERSION"
for binary in java javac jar jshell javadoc; do
  [[ -x "$JAVA_CURRENT/bin/$binary" ]] &&
    managed_link "$JAVA_CURRENT/bin/$binary" "$HOME/.local/bin/$binary" java "$JAVA_VERSION"
done
export JAVA_HOME="$JAVA_CURRENT"
export PATH="$JAVA_HOME/bin:$PATH"

print_summary "Languages & Runtimes"
