#!/usr/bin/env bash
if [[ -z "${DOTFILES_SOURCE_DIR:-}" ]]; then
  DOTFILES_SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
fi
# shellcheck source=scripts/lib.sh
source "$DOTFILES_SOURCE_DIR/scripts/lib.sh"

log_step "Installing Container & Cloud Tools"
require_sudo
ARCH="$(get_arch)"
case "$ARCH" in
  amd64)
    RELEASE_ARCH=amd64
    HASHI_ARCH=amd64
    AWS_ARCH=x86_64
    S5CMD_ARCH=64bit
    KUBECTX_ARCH=x86_64
    ;;
  arm64)
    RELEASE_ARCH=arm64
    HASHI_ARCH=arm64
    AWS_ARCH=aarch64
    S5CMD_ARCH=arm64
    KUBECTX_ARCH=arm64
    ;;
  *)
    log_error "Unsupported cloud-tool architecture: $ARCH"
    exit 1
    ;;
esac

# Converge legacy and current Microsoft repository definitions before the first
# apt operation so duplicate-source warnings cannot leak into this section.
if [[ ! -f /etc/apt/keyrings/microsoft.gpg ]]; then
  log_info "Installing Microsoft's Azure CLI repository signing key"
  sudo mkdir -p /etc/apt/keyrings
  install_apt_key \
    https://packages.microsoft.com/keys/microsoft.asc \
    /etc/apt/keyrings/microsoft.gpg \
    BC528686B50D79E339D3721CEB3E94ADBE1229CF
fi
AZURE_CODENAME="$(
  . /etc/os-release
  printf '%s' "$VERSION_CODENAME"
)"
AZURE_APT_SOURCE="$(printf '%s\n' \
  'Types: deb' \
  'URIs: https://packages.microsoft.com/repos/azure-cli/' \
  "Suites: $AZURE_CODENAME" \
  'Components: main' \
  "Architectures: $(dpkg --print-architecture)" \
  'Signed-By: /etc/apt/keyrings/microsoft.gpg')"
reconcile_apt_source \
  /etc/apt/sources.list.d/azure-cli.sources \
  "$AZURE_APT_SOURCE" \
  /etc/apt/sources.list.d/azure-cli.list

# Preserve the installed Docker package family. Docker CE's containerd.io
# conflicts with Ubuntu's containerd dependency from docker.io.
mapfile -t DOCKER_PACKAGES < <(docker_apt_packages)
if [[ ${#DOCKER_PACKAGES[@]} -gt 0 ]]; then
  if dpkg_package_installed containerd.io ||
    dpkg_package_installed docker-ce ||
    dpkg_package_installed docker-ce-cli; then
    log_info "Docker CE package ownership detected"
  else
    log_info "Ubuntu Docker package ownership selected"
  fi
  apt_install "${DOCKER_PACKAGES[@]}"
else
  log_skip "Docker CLI and Compose plugin already installed"
fi
if is_installed docker && [[ ! -f /usr/share/zsh/vendor-completions/_docker ]]; then
  sudo mkdir -p /usr/share/zsh/vendor-completions
  docker completion zsh | sudo tee /usr/share/zsh/vendor-completions/_docker >/dev/null
  log_success "Generated Docker zsh completion from the installed CLI"
fi
if is_native && is_installed docker; then
  sudo usermod -aG docker "$(whoami)" || true
  log_warn "Docker group changes take effect after the next login"
fi

KUBECTL_VERSION="$(package_version cloud kubectl 1.36.3)"
if ! is_installed kubectl || ! version_ge "$(kubectl version --client 2>/dev/null | head -1 || true)" "$KUBECTL_VERSION"; then
  tmpdir="$(mktemp -d)"
  url="https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${RELEASE_ARCH}/kubectl"
  log_info "Installing kubectl $KUBECTL_VERSION"
  download_verified "$url" "$tmpdir/kubectl" "$url.sha256" kubectl
  install_managed_binary "$tmpdir/kubectl" kubectl "$KUBECTL_VERSION" dl.k8s.io
  rm -rf "$tmpdir"
  ((_INSTALLED++)) || true
else
  log_skip "kubectl $KUBECTL_VERSION already installed or newer"
fi

HELM_VERSION="$(package_version cloud helm 4.2.3)"
if ! is_installed helm || ! version_ge "$(helm version --short 2>/dev/null || true)" "$HELM_VERSION"; then
  tmpdir="$(mktemp -d)"
  asset="helm-v${HELM_VERSION}-linux-${RELEASE_ARCH}.tar.gz"
  url="https://get.helm.sh/$asset"
  log_info "Installing Helm $HELM_VERSION"
  download_verified "$url" "$tmpdir/$asset" "$url.sha256sum" "$asset"
  tar -xzf "$tmpdir/$asset" -C "$tmpdir"
  install_managed_binary "$tmpdir/linux-${RELEASE_ARCH}/helm" helm "$HELM_VERSION" get.helm.sh
  rm -rf "$tmpdir"
  ((_INSTALLED++)) || true
else
  log_skip "Helm $HELM_VERSION already installed or newer"
fi

TERRAFORM_VERSION="$(package_version cloud terraform 1.15.8)"
if ! is_installed terraform || ! version_ge "$(terraform version 2>/dev/null | head -1 || true)" "$TERRAFORM_VERSION"; then
  tmpdir="$(mktemp -d)"
  asset="terraform_${TERRAFORM_VERSION}_linux_${HASHI_ARCH}.zip"
  base="https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}"
  log_info "Installing Terraform $TERRAFORM_VERSION"
  download_verified "$base/$asset" "$tmpdir/$asset" \
    "$base/terraform_${TERRAFORM_VERSION}_SHA256SUMS" "$asset"
  unzip -q "$tmpdir/$asset" -d "$tmpdir"
  install_managed_binary "$tmpdir/terraform" terraform "$TERRAFORM_VERSION" releases.hashicorp.com
  rm -rf "$tmpdir"
  ((_INSTALLED++)) || true
else
  log_skip "Terraform $TERRAFORM_VERSION already installed or newer"
fi

apt_install ansible kcat pgloader

K9S_VERSION="$(package_version cloud k9s 0.51.0)"
install_github_archive \
  k9s derailed/k9s "v${K9S_VERSION#v}" \
  "k9s_Linux_${RELEASE_ARCH}.tar.gz" k9s \
  "https://github.com/derailed/k9s/releases/download/{tag}/checksums.sha256" \
  'k9s version --short'

AWS_VERSION="$(package_version cloud aws_cli 2.36.7)"
AWS_CURRENT="$(aws --version 2>/dev/null || true)"
if ! is_installed aws || ! version_ge "$AWS_CURRENT" "$AWS_VERSION"; then
  AWS_SHA="$(package_metadata cloud aws_cli "sha256_$ARCH")"
  tmpdir="$(mktemp -d)"
  asset="awscli-exe-linux-${AWS_ARCH}-${AWS_VERSION}.zip"
  log_info "Installing AWS CLI $AWS_VERSION"
  download_verified "https://awscli.amazonaws.com/$asset" "$tmpdir/$asset" "sha256:$AWS_SHA" "$asset"
  unzip -q "$tmpdir/$asset" -d "$tmpdir"
  if is_installed aws; then
    sudo "$tmpdir/aws/install" --update
  else
    sudo "$tmpdir/aws/install"
  fi
  rm -rf "$tmpdir"
  record_install aws "$AWS_VERSION" aws-installer /usr/local/aws-cli
  ((_INSTALLED++)) || true
  log_success "AWS CLI $AWS_VERSION installed"
else
  log_skip "AWS CLI $AWS_VERSION already installed or newer"
fi

if [[ ! -f /etc/apt/sources.list.d/google-cloud-sdk.list ||
  ! -f /usr/share/keyrings/cloud.google.gpg ]]; then
  log_info "Configuring Google Cloud's signed apt repository"
  sudo mkdir -p /usr/share/keyrings
  install_apt_key \
    https://packages.cloud.google.com/apt/doc/apt-key.gpg \
    /usr/share/keyrings/cloud.google.gpg \
    35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3
  printf '%s\n' \
    'deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main' |
    sudo tee /etc/apt/sources.list.d/google-cloud-sdk.list >/dev/null
fi

apt_update
log_info "Ensuring Google Cloud CLI and Azure CLI are current from their signed repositories"
sudo apt-get install -y google-cloud-cli azure-cli
log_success "Google Cloud CLI $(gcloud version --format=json 2>/dev/null | jq -r '."Google Cloud SDK" // "unknown"') is current"
log_success "Azure CLI $(az version --query '"azure-cli"' -o tsv 2>/dev/null || printf unknown) is current"

CLOUDFLARED_VERSION="$(package_version cloud cloudflared 2026.7.3)"
if ! is_installed cloudflared ||
  ! version_ge "$(cloudflared --version 2>/dev/null || true)" "$CLOUDFLARED_VERSION"; then
  tmpdir="$(mktemp -d)"
  asset="cloudflared-linux-${ARCH}.deb"
  CLOUDFLARED_SHA="$(package_metadata cloud cloudflared "sha256_$ARCH")"
  log_info "Installing cloudflared $CLOUDFLARED_VERSION"
  download_verified \
    "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/$asset" \
    "$tmpdir/$asset" "sha256:$CLOUDFLARED_SHA" "$asset"
  sudo dpkg -i "$tmpdir/$asset"
  rm -rf "$tmpdir"
  record_install cloudflared "$CLOUDFLARED_VERSION" github:cloudflare/cloudflared /usr/bin/cloudflared
  ((_INSTALLED++)) || true
  log_success "cloudflared $CLOUDFLARED_VERSION installed"
else
  log_skip "cloudflared $CLOUDFLARED_VERSION already installed or newer"
fi

STERN_VERSION="$(package_version cloud stern 1.34.0)"
install_github_archive \
  stern stern/stern "v${STERN_VERSION#v}" \
  "stern_${STERN_VERSION}_linux_${ARCH}.tar.gz" stern \
  "https://github.com/stern/stern/releases/download/{tag}/checksums.txt" \
  'stern --version'

S5CMD_VERSION="$(package_version cloud s5cmd 2.3.0)"
install_github_archive \
  s5cmd peak/s5cmd "v${S5CMD_VERSION#v}" \
  "s5cmd_{version}_Linux-${S5CMD_ARCH}.tar.gz" s5cmd \
  "https://github.com/peak/s5cmd/releases/download/{tag}/s5cmd_checksums.txt" \
  's5cmd version'

HELMFILE_VERSION="$(package_version cloud helmfile 1.7.1)"
install_github_archive \
  helmfile helmfile/helmfile "v${HELMFILE_VERSION#v}" \
  "helmfile_{version}_linux_${RELEASE_ARCH}.tar.gz" helmfile \
  "https://github.com/helmfile/helmfile/releases/download/{tag}/helmfile_{version}_checksums.txt" \
  'helmfile --version'

KUBECTX_VERSION="$(package_version cloud kubectx 0.11.0)"
install_github_archive \
  kubectx ahmetb/kubectx "v${KUBECTX_VERSION#v}" \
  "kubectx_v{version}_linux_${KUBECTX_ARCH}.tar.gz" kubectx \
  "https://github.com/ahmetb/kubectx/releases/download/{tag}/checksums.txt" \
  'kubectx --version'

KUBENS_VERSION="$(package_version cloud kubens 0.11.0)"
install_github_archive \
  kubens ahmetb/kubectx "v${KUBENS_VERSION#v}" \
  "kubens_v{version}_linux_${KUBECTX_ARCH}.tar.gz" kubens \
  "https://github.com/ahmetb/kubectx/releases/download/{tag}/checksums.txt" \
  'kubens --version'

KUBECOLOR_VERSION="$(package_version cloud kubecolor 0.6.0)"
install_github_archive \
  kubecolor kubecolor/kubecolor "v${KUBECOLOR_VERSION#v}" \
  "kubecolor_{version}_linux_${RELEASE_ARCH}.tar.gz" kubecolor \
  "https://github.com/kubecolor/kubecolor/releases/download/{tag}/checksums.txt" \
  'kubecolor --kubecolor-version'

USQL_SHA="$(package_metadata database usql "sha256_$ARCH")"
USQL_VERSION="$(package_version database usql 0.21.4)"
install_github_archive \
  usql xo/usql "v${USQL_VERSION#v}" \
  "usql-${USQL_VERSION}-linux-${ARCH}.tar.bz2" usql \
  "sha256:$USQL_SHA" \
  'usql --version'

if ! is_installed iredis; then
  if is_installed uv; then
    log_info "Installing iredis via uv..."
    uv tool install iredis --quiet 2>/dev/null || pip install --user iredis 2>/dev/null || true
    log_success "iredis installed"
  fi
else
  log_skip "iredis already installed"
fi

# Pre-generate offline Zsh completion definitions for kubectl, helm, docker
mkdir -p "$HOME/.zsh/completions"
if is_installed kubectl; then
  kubectl completion zsh >"$HOME/.zsh/completions/_kubectl" 2>/dev/null || true
fi
if is_installed helm; then
  helm completion zsh >"$HOME/.zsh/completions/_helm" 2>/dev/null || true
fi
if is_installed docker; then
  docker completion zsh >"$HOME/.zsh/completions/_docker" 2>/dev/null || true
fi

log_info "Cloud authentication is intentionally not automated"
print_summary "Container & Cloud Tools"
