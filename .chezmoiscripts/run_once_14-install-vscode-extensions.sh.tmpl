#!/usr/bin/env bash
if [[ -z "${DOTFILES_SOURCE_DIR:-}" ]]; then
  DOTFILES_SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
fi
# shellcheck source=scripts/lib.sh
source "$DOTFILES_SOURCE_DIR/scripts/lib.sh"

log_step "Installing VS Code Extensions (Fallback)"

if ! is_installed code; then
  log_skip "VS Code not installed — skipping extension installation"
  log_info "Recommendation: Use VS Code Settings Sync (GitHub account) for extensions"
  print_summary "VS Code Extensions"
  exit 0
fi

log_info "VS Code detected — installing extensions from saved list"
log_info "Note: Prefer VS Code Settings Sync for ongoing sync"

# Core extensions — install if not present
EXTENSIONS=(
  enkia.tokyo-night
  impasse52.catppuccin-mocha-darker
  pkief.material-icon-theme
  vscodevim.vim
  eamodio.gitlens
  usernamehw.errorlens
  esbenp.prettier-vscode
  dbaeumer.vscode-eslint
  ms-python.python
  ms-python.vscode-pylance
  golang.go
  rust-lang.rust-analyzer
  redhat.java
  redhat.vscode-yaml
  redhat.ansible
  hashicorp.terraform
  ms-azuretools.vscode-docker
  ms-kubernetes-tools.vscode-kubernetes-tools
  ms-vscode-remote.remote-ssh
  ms-vscode-remote.remote-wsl
  ms-vscode-remote.remote-containers
  github.vscode-github-actions
  github.vscode-pull-request-github
  mads-hartmann.bash-ide-vscode
  gruntfuggly.todo-tree
  charliermarsh.ruff
  streetsidesoftware.code-spell-checker
)

cache_root="$(managed_state_root)"
ensure_private_directory "$cache_root"
cache="$cache_root/vscode-extensions.list"
cache_key="$(printf '%s\n' "$(command -v code)" "$(stat -Lc '%s:%Y' "$(command -v code)")" "${EXTENSIONS[@]}" | sha256sum | cut -d' ' -f1)"
cache_age=300
if [[ -f "$cache" && ! -L "$cache" ]]; then
  cache_age=$(($(date +%s) - $(stat -c %Y "$cache")))
fi
if [[ "${DOTFILES_REFRESH_VSCODE:-0}" != 1 && "$cache_age" -ge 0 && "$cache_age" -lt 300 && "$(head -1 "$cache")" == "$cache_key" ]]; then
  INSTALLED_EXTENSIONS="$(tail -n +2 "$cache")"
  log_info "Using recent VS Code inventory (5-minute TTL; DOTFILES_REFRESH_VSCODE=1 refreshes it)"
else
  if ! INSTALLED_EXTENSIONS=$(timeout 45 code --list-extensions); then
    log_warn "VS Code inventory failed or exceeded 45s; leaving extensions unchanged"
    print_summary "VS Code Extensions"
    exit 0
  fi
  temporary="$(mktemp "$cache_root/.vscode-extensions.XXXXXX")"
  printf '%s\n%s\n' "$cache_key" "$INSTALLED_EXTENSIONS" >"$temporary"
  chmod 600 "$temporary"
  mv -Tf -- "$temporary" "$cache"
fi

for ext in "${EXTENSIONS[@]}"; do
  if grep -Fxiq -- "$ext" <<<"$INSTALLED_EXTENSIONS"; then
    log_skip "$ext"
  else
    log_info "Installing $ext..."
    rm -f -- "$cache"
    code --install-extension "$ext" --force 2>/dev/null &&
      log_success "$ext installed" ||
      log_warn "Failed to install $ext"
  fi
done

print_summary "VS Code Extensions"
